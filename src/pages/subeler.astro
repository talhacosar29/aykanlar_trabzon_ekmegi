---
import Base from '../layouts/Base.astro';
import { branches } from '../data/site.js';
---

<Base
  title="Şubeler | Aykanlar Trabzon Ekmeği"
  description="Aykanlar Trabzon Ekmeği Tuzla ve İzmit şubeleri. İstanbul ve İzmit’te her gün taze ekmek."
  path="/subeler"
>
  <section class="wrap page-hero">
    <span class="eyebrow">Şubeler</span>
    <h1>Nereden ulaşabilirsiniz.</h1>
    <p>
      Tuzla üretim ve satış noktamız ile İzmit şubemiz. Yol tarifi için haritayı kullanabilirsiniz.
    </p>
  </section>

  <section class="wrap">
    {branches.map((b) => (
      <article class="branch" id={b.id} data-reveal>
        <div class="branch-info">
          <span class="eyebrow">{b.role}</span>
          <h2>{b.title}</h2>
          <p>{b.name}</p>
          <p>{b.street}</p>
          <p>{b.district}</p>
          {b.phone && (
            <p><a href={b.phoneHref}>{b.phone}</a></p>
          )}
          <a class="btn btn-dark" href={b.maps} target="_blank" rel="noopener noreferrer">Yol Tarifi Al</a>
        </div>
        <iframe
          title={`Aykanlar ${b.title} konumu`}
          src={b.mapsEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </article>
    ))}
  </section>
</Base>
