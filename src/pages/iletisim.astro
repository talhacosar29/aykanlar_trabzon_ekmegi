---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---

<Base
  title="İletişim | Aykanlar Trabzon Ekmeği"
  description="Aykanlar Trabzon Ekmeği ile iletişime geçin. Tuzla adresi, telefon ve Instagram."
  path="/iletisim"
>
  <section class="wrap contact-grid" style="padding-top:4.5rem">
    <div>
      <span class="eyebrow">İletişim</span>
      <h1>Bizimle iletişime geçin</h1>
      <p class="lead">
        Sipariş, şube ve ürün sorularınız için formu doldurabilir veya doğrudan arayabilirsiniz.
        Form bu demoda yalnızca tarayıcıda çalışır.
      </p>
      <div class="contact-meta">
        <div>
          <span>Telefon</span>
          <a href={site.phoneHref}>{site.phone}</a>
        </div>
        <div>
          <span>Adres</span>
          <p>{site.address.street}<br />{site.address.district}</p>
        </div>
        <div>
          <span>Instagram</span>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer">{site.instagramHandle}</a>
        </div>
        <div>
          <span>Bölge</span>
          <p>{site.regions}</p>
        </div>
      </div>
    </div>

    <form data-contact-form data-reveal>
      <div>
        <label for="ad">Ad Soyad</label>
        <input id="ad" name="ad" type="text" required autocomplete="name" />
      </div>
      <div>
        <label for="tel">Telefon</label>
        <input id="tel" name="tel" type="tel" required autocomplete="tel" />
      </div>
      <div>
        <label for="eposta">E-posta</label>
        <input id="eposta" name="eposta" type="email" required autocomplete="email" />
      </div>
      <div>
        <label for="mesaj">Mesaj</label>
        <textarea id="mesaj" name="mesaj" required></textarea>
      </div>
      <button class="btn btn-dark" type="submit">Mesaj Gönder</button>
      <p class="form-note" data-form-note hidden></p>
    </form>
  </section>

  <div class="map-full">
    <iframe
      title="Aykanlar Tuzla haritası"
      src={site.mapsEmbed}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</Base>
