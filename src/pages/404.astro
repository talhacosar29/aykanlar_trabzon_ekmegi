---
import Base from '../layouts/Base.astro';
import { url } from '../data/site.js';
---

<Base
  title="Sayfa bulunamadı | Aykanlar Trabzon Ekmeği"
  description="Aradığınız sayfa bulunamadı."
  path="/404"
>
  <section class="notfound">
    <span class="eyebrow">404</span>
    <h1>Sayfa fırında yok.</h1>
    <p class="lead" style="margin: 0 auto 1.6rem">Aradığınız içerik taşınmış veya hiç pişmemiş olabilir.</p>
    <a class="btn btn-dark" href={url('/')}>Ana Sayfaya Dön</a>
  </section>
</Base>
